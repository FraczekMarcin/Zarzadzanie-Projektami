# ==============================================================================
# Zarządzanie Projektami - Przykładowa konfiguracja środowiskowa (.env)
# ==============================================================================

# Port serwera Express (domyślnie 3000)
PORT=3000

# Ścieżka do katalogu trwałego zapisu danych (baza JSON, sesje użytkowników)
# Domyślnie: ./data w trybie deweloperskim, /app/data w kontenerze produkcyjnym Docker
DATA_DIR=./data

# Bazowy adres URL aplikacji (używany m.in. do generowania linków w powiadomieniach i kalendarzu)
APP_URL=http://localhost:3000

# Zaufane proxy (np. Nginx, Traefik, Caddy, Cloudflare)
# Wartości: true (ufaj wszystkim), false (nie ufaj), 1 (jeden przeskok), lub lista IP
# Wymagane, aby nagłówki X-Forwarded-Proto i X-Forwarded-For były bezpiecznie uwzględniane
TRUST_PROXY=false

# ==============================================================================
# Konfiguracja serwera pocztowego SMTP (do wysyłki kodów jednorazowych resetu hasła)
# Jeśli poniższe zmienne nie zostaną zdefiniowane, funkcja wysyłki e-mail jest wyłączona,
# a hasła mogą być zmieniane/resetowane bezpośrednio przez Administratora w panelu.
# ==============================================================================
SMTP_HOST=smtp.twojadomena.pl
SMTP_PORT=587
SMTP_USER=powiadomienia@twojadomena.pl
SMTP_PASS=twoje-tajne-haslo-smtp
SMTP_FROM="Zarządzanie Projektami" <powiadomienia@twojadomena.pl>

# ==============================================================================
# Kontrola rejestracji i instalacji systemu
# ==============================================================================
# Zezwolenie na samodzielną rejestrację użytkowników z poziomu formularza logowania (domyślnie: true)
ALLOW_SELF_REGISTRATION=true

# Opcjonalny jednorazowy token zabezpieczający kreator pierwszego administratora
# Jeśli ustawiony, żądanie POST /api/auth/setup-admin wymaga podania tego tokena w polu setupToken
# SETUP_TOKEN=bardzo-tajny-token-instalacyjny-2026

