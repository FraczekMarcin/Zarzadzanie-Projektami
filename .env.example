# Port serwera Express
PORT=3000

# Konfiguracja serwera pocztowego SMTP do wysyłki kodów resetu hasła (opcjonalnie)
# Jeśli zmienne nie są zdefiniowane, funkcja resetu hasła przez e-mail jest wyłączona,
# a hasło może zostać zresetowane przez Administratora pracowni w panelu użytkowników.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=twoj-email@gmail.com
# SMTP_PASS=haslo-aplikacji
# SMTP_FROM="Zarządzanie Projektami" <noreply@pracownia.pl>
