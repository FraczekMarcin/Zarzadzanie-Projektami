# ==============================================================================
# Zarządzanie Projektami - Przykładowa konfiguracja środowiskowa dla Dockera (.env)
# ==============================================================================
# Skopiuj ten plik jako `.env` na serwerze wdrożeniowym i odkomentuj potrzebne
# zmienne (w typowym wdrożeniu przez `sudo bash install.sh` plik `.env` jest
# generowany automatycznie z losowym APP_SECRET).
# Ustawienia SMTP, rejestracji oraz limitów sesji można wygodnie konfigurować
# także bezpośrednio w interfejsie Administratora (Ustawienia).
# ==============================================================================

# ==============================================================================
# Podstawowa konfiguracja serwera i magazynu danych
# ==============================================================================
# Tryb uruchomienia Node.js (development | production)
# NODE_ENV=production

# Port serwera Express (domyślnie: 3000)
# PORT=3000

# Ścieżka do katalogu trwałego zapisu danych (app_state.json, sessions.json, security_log.jsonl)
# Domyślnie: ./data w trybie deweloperskim, /app/data w kontenerze produkcyjnym Docker
# DATA_DIR=/app/data

# Typ magazynu danych serwera (domyślnie i jedyny obecnie obsługiwany: json)
# STORAGE=json

# Opcjonalny katalog kopii zapasowych sprawdzany przez wskaźnik stanu kopii w UI
# Domyślnie przeszukiwane są m.in. /opt/zarzadzanie-projektami/backups oraz ./backups
# BACKUP_DIR=/app/backups

# Maksymalny wiek najnowszej kopii zapasowej w godzinach przed wyzwoleniem alertu (domyślnie: 36)
# BACKUP_MAX_AGE_HOURS=36

# Lista adresów e-mail (rozdzielona przecinkami) otrzymujących alerty o braku świeżej kopii i niskim miejscu na dysku
# Gdy pusta, alerty trafiają do aktywnych administratorów posiadających adres e-mail (wymaga SMTP)
# BACKUP_ALERT_EMAILS=admin@twojadomena.pl,ops@twojadomena.pl

# Próg ostrzeżenia e-mail o niskim wolnym miejscu na dysku serwera w procentach (domyślnie: 10)
# DISK_ALERT_PERCENT=10

# Minimalny próg ostrzeżenia e-mail o wolnym miejscu na dysku serwera w MB (domyślnie: 500)
# DISK_ALERT_MIN_MB=500

# Nadpisanie wersji zgłaszanej przez /api/health i /api/system-info (domyślnie czytana z pliku VERSION)
# APP_VERSION=

# ==============================================================================
# Logowanie serwera (src/server/logger.ts)
# ==============================================================================
# Poziom szczegółowości logów: debug | info | warn | error (domyślnie: info)
# LOG_LEVEL=info

# Format wpisów logu: text (czytelny prefiks ISO + poziom) | json (jedna linia JSON na wpis)
# LOG_FORMAT=text

# ==============================================================================
# Adresy URL, Reverse Proxy i HTTPS
# ==============================================================================
# Bazowy adres URL aplikacji (używany m.in. w dokumentacji wdrożeniowej)
# APP_URL=http://localhost:3000

# Opcjonalny publiczny adres bazowy HTTPS (np. przez tunel lub reverse proxy) dla subskrypcji iCal / Kalendarza Google
# PUBLIC_BASE_URL=https://kalendarz.pracownia.pl

# Zaufane proxy (np. Nginx, Traefik, Caddy, Cloudflare)
# Wartości: false (nie ufaj), true (ufaj wszystkim), 1 (jeden przeskok), lub lista IP
# Wymagane w trybie HTTPS za reverse proxy, aby nagłówki X-Forwarded-Proto i X-Forwarded-For były uwzględniane
# TRUST_PROXY=false

# Host/IP używany przez Caddy w trybie HTTPS (docker-compose.https.yml + Caddyfile)
# APP_HOST=192.168.1.100

# Adres nasłuchiwania oraz port hosta w trybie HTTP (docker-compose.yml)
# APP_BIND=0.0.0.0
# APP_PORT=3000

# ==============================================================================
# Łączenie plików Docker Compose (COMPOSE_FILE)
# ==============================================================================
# Docker Compose automatycznie łączy pliki wymienione w COMPOSE_FILE (separator ':').
# UWAGA: Jeśli ustawisz COMPOSE_FILE w .env i NIE uwzględnisz w nim
# docker-compose.https.yml, kontener Caddy oraz obsługa HTTPS zostaną wyłączone!
#
# Gotowe przykłady konfiguracji (odkomentuj dokładnie jeden wariant):
#
# 1) Tylko HTTP na porcie 3000 (zachowanie domyślne, gdy COMPOSE_FILE jest zakomentowane):
# COMPOSE_FILE=docker-compose.yml
#
# 2) HTTPS w sieci lokalnej z Caddy Reverse Proxy (wymaga też ustawienia APP_HOST):
# COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml
#
# 3) HTTPS + jednokierunkowa synchronizacja z Kalendarzem Google:
# COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml:docker-compose.google.yml

# ==============================================================================
# Klucz bezpieczeństwa aplikacji i odzyskiwanie 2FA
# ==============================================================================
# Wymagany w środowisku produkcyjnym (NODE_ENV=production) – co najmniej 64 znaki hex / 32 bajty entropii.
# Używany do szyfrowania sekretów 2FA, haseł SMTP w bazie (AES-256-GCM) oraz zabezpieczenia sesji.
# Wygeneruj poleceniem: openssl rand -hex 32
# APP_SECRET=

# Flaga awaryjnego odzyskiwania przy utracie APP_SECRET (true | 1 | false).
# Ustawienie na true resetuje niemożliwe do odszyfrowania sekrety 2FA przy starcie serwera.
# Po udanym uruchomieniu usuń lub ustaw z powtem na false!
# RESET_2FA_ON_START=false

# ==============================================================================
# Kontrola rejestracji i instalacji systemu
# ==============================================================================
# Zezwolenie na samodzielną rejestrację użytkowników z poziomu formularza logowania (domyślnie: true)
# Uwaga: ustawienie w .env nadpisuje i blokuje edycję tego pola w panelu Administratora.
# ALLOW_SELF_REGISTRATION=true

# Opcjonalny jednorazowy token zabezpieczający kreator pierwszego administratora
# Jeśli ustawiony, żądanie POST /api/auth/setup-admin wymaga podania tego tokena w polu setupToken
# SETUP_TOKEN=bardzo-tajny-token-instalacyjny-2026

# ==============================================================================
# Zarządzanie sesjami i wygasanie
# ==============================================================================
# Czas bezczynności (w minutach), po którym sesja użytkownika automatycznie wygasa (5–1440, domyślnie: 120)
# Uwaga: ustawienie w .env nadpisuje i blokuje edycję tego pola w panelu Administratora.
# SESSION_IDLE_MINUTES=120

# Maksymalny bezwzględny czas trwania sesji (w godzinach) od momentu zalogowania (1–168, domyślnie: 12)
# Uwaga: ustawienie w .env nadpisuje i blokuje edycję tego pola w panelu Administratora.
# SESSION_MAX_HOURS=12

# Zezwolenie na opcję „Ufaj temu urządzeniu” przy logowaniu (true | false, domyślnie: true)
# Uwaga: ustawienie w .env nadpisuje i blokuje edycję tego pola w zakładce Dostęp i sesje.
# TRUSTED_DEVICES_ENABLED=true

# Liczba dni ważności zaufanego urządzenia (1–90, domyślnie: 30)
# Uwaga: ustawienie w .env nadpisuje i blokuje edycję tego pola w zakładce Dostęp i sesje.
# TRUSTED_DEVICE_DAYS=30

# Liczba dni przechowywania usuniętych zadań i projektów w koszu (1–365, domyślnie: 30)
# Uwaga: ustawienie w .env nadpisuje i blokuje edycję tego pola w panelu Administratora.
# TRASH_RETENTION_DAYS=30

# ==============================================================================
# Konfiguracja serwera pocztowego SMTP (reset hasła, alerty kopii, testy w UI)
# ==============================================================================
# Wszystkie pola SMTP można skonfigurować bezpośrednio w panelu Administratora w UI.
# Ustawienie poniższych zmiennych w .env ma pierwszeństwo i blokuje odpowiednie pola w UI.
# SMTP_HOST=smtp.twojadomena.pl
# SMTP_PORT=587
# SMTP_ENCRYPTION=starttls
# SMTP_USER=powiadomienia@twojadomena.pl
# SMTP_PASS=twoje-tajne-haslo-smtp
# SMTP_FROM="Zarządzanie Projektami" <powiadomienia@twojadomena.pl>
# SMTP_ALLOW_SELF_SIGNED=false

# ==============================================================================
# Dzienne przypomnienia e-mail o terminach zadań (wymaga SMTP)
# ==============================================================================
# Włączenie codziennych zbiorczych przypomnień e-mail o zbliżających się i zaległych terminach (domyślnie: false)
# Uwaga: ustawienie w .env ma pierwszeństwo i blokuje pole w zakładce Ustawienia -> Powiadomienia.
# REMINDERS_ENABLED=false

# Strefa czasowa harmonogramu w formacie IANA (domyślnie: Europe/Warsaw)
# REMINDER_TIMEZONE=Europe/Warsaw

# Godzina wysyłki przypomnień (0–23 w wybranej strefie czasowej, domyślnie: 8)
# REMINDER_SEND_HOUR=8

# ==============================================================================
# Cotygodniowe podsumowanie projektów dla kierowników (wymaga SMTP)
# ==============================================================================
# Włączenie cotygodniowych raportów zaległych i kończących się zadań (domyślnie: false)
# Uwaga: ustawienie w .env ma pierwszeństwo i blokuje pole w zakładce Ustawienia -> Powiadomienia.
# WEEKLY_SUMMARY_ENABLED=false

# Dzień tygodnia wysyłki (1 = poniedziałek ... 7 = niedziela, domyślnie: 1)
# WEEKLY_SUMMARY_DAY=1

# Godzina wysyłki w formacie HH:MM w strefie REMINDER_TIMEZONE (domyślnie: 08:00)
# WEEKLY_SUMMARY_TIME=08:00

# ==============================================================================
# Opcjonalna jednokierunkowa synchronizacja z Kalendarzem Google (Service Account)
# ==============================================================================
# Gdy poniższe zmienne nie są ustawione, funkcja pozostaje wyłączona.
# W Dockerze umieść klucz JSON w ./secrets/google_sa.json i dopisz docker-compose.google.yml do COMPOSE_FILE.
# GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google_sa.json
# GOOGLE_CALENDAR_ID=twoj_kalendarz@group.calendar.google.com
